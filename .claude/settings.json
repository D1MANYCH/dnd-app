{
  "permissions": {
    "allow": [
      "mcp__Claude_Browser__preview_start",
      "mcp__Claude_Browser__preview_list",
      "mcp__Claude_Browser__preview_stop",
      "mcp__Claude_Browser__preview_logs",
      "mcp__Claude_Browser__navigate",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__Claude_Browser__javascript_tool",
      "mcp__Claude_Browser__computer",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__form_input",
      "mcp__Claude_Browser__resize_window",
      "mcp__Claude_Browser__tabs_context"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node tools/check-sw-hook.js"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "node -e 'let i=\"\";process.stdin.on(\"data\",d=>i+=d).on(\"end\",()=>{const j=JSON.parse(i);const p=(j.tool_input&&j.tool_input.file_path)||\"\";if(/data\\.js$/i.test(p)){const s=require(\"fs\").readFileSync(p,\"utf8\");const v=(s.match(/APP_VERSION\\s*=\\s*[\\x22]([^\\x22]+)[\\x22]/)||[])[1];const c=(s.match(/APP_CHANGELOG\\s*=\\s*\\[\\s*\\{[^}]*?version\\s*:\\s*[\\x22]([^\\x22]+)[\\x22]/)||[])[1];if(v&&c&&v!==c){console.error(\"data.js: APP_VERSION=\"+v+\" != APP_CHANGELOG[0]=\"+c);process.exit(2)}}})'"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "node tools/run-tests-hook.js"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "node tools/check-theme.js --hook"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "node tools/check-syntax-hook.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node tools/check-uncommitted-hook.js"
          }
        ]
      }
    ]
  }
}
